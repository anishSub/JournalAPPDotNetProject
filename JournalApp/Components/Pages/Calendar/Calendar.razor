@page "/calendar"
@inject JournalApp.Services.IJournalService JournalService
@using System.Globalization

<div class="calendar-container">
    <div class="calendar-header">
        <h1>Calendar</h1>
    </div>

    <div class="calendar-layout">
        <!-- Calendar Grid Card -->
        <div class="calendar-card">
            <div class="calendar-nav">
                <button class="nav-btn" @onclick="PrevMonth">‹</button>
                <div class="current-month">
                    <h2>@CurrentMonth.ToString("MMMM")</h2>
                    <span>@CurrentMonth.Year</span>
                </div>
                <button class="nav-btn" @onclick="NextMonth">›</button>
            </div>

            <div class="calendar-grid">
                <!-- Weekday Headers -->
                <div class="weekday-header">Sun</div>
                <div class="weekday-header">Mon</div>
                <div class="weekday-header">Tue</div>
                <div class="weekday-header">Wed</div>
                <div class="weekday-header">Thu</div>
                <div class="weekday-header">Fri</div>
                <div class="weekday-header">Sat</div>

                <!-- Empty slots for start of month -->
                @for (int i = 0; i < StartOffset; i++)
                {
                    <div class="day-cell empty"></div>
                }

                <!-- Days -->
                @for (int day = 1; day <= DaysInMonth; day++)
                {
                    int localDay = day; // capture value for lambda
                    var date = new DateTime(CurrentMonth.Year, CurrentMonth.Month, localDay);
                    bool isToday = date.Date == DateTime.Today;
                    bool hasEntry = HasEntry(date);
                    bool isSelected = SelectedDate.Date == date.Date;

                    <button class="day-cell @(isToday ? "today" : "") @(isSelected ? "selected" : "")" 
                            type="button"
                            @onclick="() => SelectDate(localDay)">
                        <span class="day-number">@localDay</span>
                        @if (hasEntry)
                        {
                            <span class="entry-dot"></span>
                        }
                    </button>
                }
            </div>

            <div class="calendar-legend">
                <div class="legend-item">
                    <span class="dot has-entry"></span> Has Entry
                </div>
                <div class="legend-item">
                    <span class="dot today"></span> Today
                </div>
            </div>
        </div>

        <!-- Entries Side Panel -->
        <div class="entries-card">
            <h3>Entries for @SelectedDate.ToString("MMMM d")</h3>
            
            <div class="entries-list">
                @if (DisplayedEntries.Any())
                {
                    @foreach (var entry in DisplayedEntries)
                    {
                        <div class="mini-entry-card" @onclick='() => Navigation.NavigateTo($"/journal/edit/{entry.Id}")' style="cursor: pointer;">
                            <span class="entry-emoji">@(entry.Mood?.Emoji ?? "📄")</span>
                            <div class="entry-info">
                                <h4>@entry.Title</h4>
                                <span class="entry-description">@entry.Preview</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-entries">
                        <p>No entries for this day.</p>
                        <button class="btn-create-small" @onclick='() => Navigation.NavigateTo($"/journal/create?date={SelectedDate:yyyy-MM-dd}")'>
                            + Create Entry
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private DateTime CurrentMonth { get; set; } = DateTime.Today;
    private DateTime SelectedDate { get; set; } = DateTime.Today;
    private int DaysInMonth => DateTime.DaysInMonth(CurrentMonth.Year, CurrentMonth.Month);
    private int StartOffset => (int)new DateTime(CurrentMonth.Year, CurrentMonth.Month, 1).DayOfWeek;
    private List<JournalApp.Models.JournalEntry> EntriesForMonth { get; set; } = new();

    private IEnumerable<JournalApp.Models.JournalEntry> DisplayedEntries => 
        EntriesForMonth.Where(e => e.Date.Date == SelectedDate.Date);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadEntries();
            StateHasChanged();
        }
    }

    private async Task LoadEntries()
    {
        EntriesForMonth = await JournalService.GetEntriesForMonthAsync(CurrentMonth.Month, CurrentMonth.Year);
    }

    private async Task PrevMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(-1);
        SelectedDate = new DateTime(CurrentMonth.Year, CurrentMonth.Month, 1); 
        await LoadEntries();
    }

    private async Task NextMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(1);
        SelectedDate = new DateTime(CurrentMonth.Year, CurrentMonth.Month, 1);
        await LoadEntries();
    }

    private void SelectDate(int day)
    {
        SelectedDate = new DateTime(CurrentMonth.Year, CurrentMonth.Month, day);
    }

    private bool HasEntry(DateTime date)
    {
         return EntriesForMonth.Any(e => e.Date.Date == date.Date);
    }

