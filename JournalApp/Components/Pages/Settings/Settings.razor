@page "/settings"
@inject IJSRuntime JSRuntime

@using JournalApp.Services
@using System.Threading.Tasks
@inject AuthService AuthService
@inject IJournalService JournalService
@inject NavigationManager Navigation
@inject ToastService ToastService

<div class="settings-container">
    <div class="settings-content">
        <h1>Settings</h1>

        <div class="settings-grid">
            <!-- Left Column: Profile & Appearance -->
            <div class="settings-column">
                <!-- Profile Section -->
                <div class="settings-card">
                    <div class="card-header">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <h2>Profile</h2>
                    </div>

                    <div class="profile-info">
                        <div class="avatar">
                            @if (!string.IsNullOrEmpty(_profileImageBase64))
                            {
                                <img src="@_profileImageBase64" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" />
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            }
                        </div>
                        <div class="profile-text">
                            @if (_isEditingProfile)
                            {
                                <div class="edit-profile-form">
                                    <div class="profile-image-edit" style="margin-bottom: 1rem; position: relative; display: inline-block; width: 80px; height: 80px;">
                                        <label for="profileUpload" style="cursor: pointer; width: 100%; height: 100%; display: block; position: relative;">
                                            @if (!string.IsNullOrEmpty(_tempBase64))
                                            {
                                                <img src="@_tempBase64" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent-color); display: block;" />
                                            }
                                            else if (!string.IsNullOrEmpty(_profileImageBase64))
                                            {
                                                 <img src="@_profileImageBase64" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent-color); display: block;" />
                                            }
                                            else
                                            {
                                                <div style="width: 100%; height: 100%; border-radius: 50%; background-color: var(--surface-secondary); display: flex; align-items: center; justify-content: center; border: 2px dashed var(--text-secondary);">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-secondary);">
                                                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                                        <circle cx="12" cy="13" r="4"></circle>
                                                    </svg>
                                                </div>
                                            }
                                            <div style="position: absolute; bottom: 0; right: 0; background-color: var(--accent-color); color: white; border-radius: 50%; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M12 5v14M5 12h14"></path>
                                                </svg>
                                            </div>
                                        </label>
                                        <InputFile Id="profileUpload" OnChange="HandleFileSelected" style="display: none;" accept=".jpg,.jpeg,.png" />
                                    </div>
                                    <input type="text" @bind="_userName" class="profile-input" placeholder="Enter your name" />
                                    @if (HasChanges)
                                    {
                                        <button class="btn-save-profile" @onclick="SaveProfile">Save</button>
                                    }
                                    else
                                    {
                                        <button class="btn-cancel-red" @onclick="CancelEdit">Cancel</button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="view-profile">
                                    <h3>@_userName</h3>
                                    <button class="btn-edit-profile-text" @onclick="ToggleEditProfile">Edit</button>
                                </div>
                                <p>Journaling since @_memberSince</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Appearance Section -->
                <div class="settings-card">
                    <div class="card-header">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="5"></circle>
                            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
                        </svg>
                        <h2>Appearance</h2>
                    </div>

                    <div class="appearance-content">
                        <p class="theme-label">Theme</p>
                        <div class="theme-toggles">
                            <button class="theme-btn @(!_isDarkMode ? "active" : "")" @onclick="SetLightMode">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="5"></circle>
                                    <line x1="12" y1="1" x2="12" y2="3"></line>
                                    <line x1="12" y1="21" x2="12" y2="23"></line>
                                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                                    <line x1="1" y1="12" x2="3" y2="12"></line>
                                    <line x1="21" y1="12" x2="23" y2="12"></line>
                                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                                </svg>
                                Light
                            </button>
                            <button class="theme-btn @(_isDarkMode ? "active" : "")" @onclick="SetDarkMode">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                                </svg>
                                Dark
                            </button>
                        </div>
                        <p class="theme-desc">Select Light mode for clarity in bright environments, or Dark mode to reduce eye strain at night.</p>
                    </div>
                </div>
            </div>

            <!-- Right Column: Security -->
            <div class="settings-column">
                <!-- Security Settings -->
                <div class="settings-card">
                    <div class="card-header">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        <h2>Security</h2>
                    </div>

                    <div class="setting-item">
                        <div>
                            <h3 class="setting-title">Change Password</h3>
                            <p class="setting-desc">Update your main master password</p>
                        </div>
                        <button class="btn-secondary" @onclick="OpenChangePassword">Update</button>
                    </div>
                    
                    @if (_isChangePasswordVisible)
                    {
                        <div class="security-form">
                            <input type="password" @bind="_newPassword" @bind:event="oninput" placeholder="New Password" class="security-input" />
                            @if (!string.IsNullOrWhiteSpace(_newPassword))
                            {
                                <button class="btn-primary-small" @onclick="SaveNewPassword">Save</button>
                            }
                            else
                            {
                                <button class="btn-cancel-red" @onclick="CloseChangePassword">Cancel</button>
                            }
                        </div>
                    }

                    <div class="setting-item">
                        <div>
                            <h3 class="setting-title">Use PIN</h3>
                            <p class="setting-desc">Enable quick access with a numeric PIN</p>
                        </div>
                        <button class="toggle-switch @(_hasPin ? "active" : "")" @onclick="TogglePin">
                            <div class="toggle-slider"></div>
                        </button>
                    </div>

                     @if (_isSetPinVisible)
                    {
                        <div class="security-form" style="margin-bottom: 1.5rem;">
                            <input type="number" @bind="_newPin" placeholder="Enter 4-digit PIN" class="security-input" maxlength="4" />
                            <button class="btn-primary-small" @onclick="SaveNewPin">Set PIN</button>
                        </div>
                    }



                    <div class="setting-item no-border">
                        <button class="btn-sign-out" @onclick="SignOut">Sign Out</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool _isDarkMode = false;
    
    // Profile State
    private string _userName = "Journal User";
    private string _profileImagePath = "";
    private string _profileImageBase64 = ""; // Persistent Base64 for display
    private string _tempProfileImagePath = "";
    private string _tempBase64 = ""; // For immediate preview
    private bool _isEditingProfile = false;
    private string _originalUserName = "";
    
    // Computed property to check if there are any changes
    private bool HasChanges => _userName != _originalUserName || !string.IsNullOrEmpty(_tempBase64);
    
    // Security State
    private bool _hasPin = false;
    private bool _isChangePasswordVisible = false;
    private bool _isSetPinVisible = false;
    private string _newPassword = "";
    private string _newPin = "";
    private string _memberSince = "January 2026"; // Default fallback

    /// <summary>
    /// Initializes the settings page by loading user profile data, security status, and app theme.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // ... existing loading code ...

        
        // Load Profile
        _userName = Preferences.Get("UserName", "Journal User");
        _profileImagePath = Preferences.Get("UserProfileImage", "");
        
        // Load Base64 for Image Display (Fixes file:// access restrictions on Mac)
        if (!string.IsNullOrEmpty(_profileImagePath) && File.Exists(_profileImagePath))
        {
            try 
            {
                var bytes = await File.ReadAllBytesAsync(_profileImagePath);
                var base64 = Convert.ToBase64String(bytes);
                // Simple mime type detection
                var mimeType = _profileImagePath.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ? "image/png" : "image/jpeg";
                _profileImageBase64 = $"data:{mimeType};base64,{base64}";
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading profile image: {ex.Message}");
                // Fallback or leave empty to show placeholder
            }
        }
        
        // Load Security Status
        _hasPin = await AuthService.HasPinAsync();
        
        // Load Member Since Date
        var user = await JournalService.GetUserAsync();
        if (user != null)
        {
             _memberSince = user.CreatedDate.ToString("MMMM yyyy");
        }
    }

    // ... existing profile methods ...

    // Security Methods
    private void OpenChangePassword()
    {
        _isChangePasswordVisible = !_isChangePasswordVisible;
        _isSetPinVisible = false;
        _newPassword = ""; // Reset on open
    }

    private void CloseChangePassword()
    {
        _newPassword = "";
        _isChangePasswordVisible = false;
    }

    /// <summary>
    /// Validates and saves the new master password.
    /// Requires minimum length of 4 characters.
    /// </summary>
    private async Task SaveNewPassword()
    {
        if (!string.IsNullOrWhiteSpace(_newPassword) && _newPassword.Length >= 4)
        {
            await AuthService.SetPasswordAsync(_newPassword);
            _newPassword = "";
            _isChangePasswordVisible = false;
            ToastService.ShowSuccess("Password updated successfully! ");
        }
        else
        {
            ToastService.ShowError("Password must be at least 4 characters");
        }
    }

    /// <summary>
    /// Toggles the PIN security feature.
    /// If PIN exists, prompts to remove it. If not, shows input to set a new PIN.
    /// </summary>
    private async Task TogglePin()
    {
        if (_hasPin)
        {
            // Remove PIN
            bool confirm = await (Application.Current?.Windows[0].Page?.DisplayAlert("Remove PIN?", "Are you sure you want to disable PIN access?", "Yes", "No") ?? Task.FromResult(false));
            if (confirm)
            {
                AuthService.RemovePin();
                _hasPin = false;
                _isSetPinVisible = false;
                ToastService.ShowInfo("PIN removed successfully");
            }
        }
        else
        {
            // Enable PIN (Show Input)
            _isSetPinVisible = true;
            _isChangePasswordVisible = false;
        }
    }

    private async Task SaveNewPin()
    {
        if (!string.IsNullOrWhiteSpace(_newPin) && _newPin.Length >= 4)
        {
            await AuthService.SetPinAsync(_newPin);
            _hasPin = true;
            _newPin = "";
            _isSetPinVisible = false;
            ToastService.ShowSuccess("PIN set successfully! ");
        }
         else
        {
            ToastService.ShowError("PIN must be at least 4 digits");
        }
    }

    private void SignOut()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login", true); 
    }
    
    // --- Safe Alert Helper ---
    private async Task ShowAlert(string title, string message, string cancel = "OK")
    {
        if (Application.Current?.Windows.Count > 0)
        {
            await (Application.Current.Windows[0].Page?.DisplayAlert(title, message, cancel) ?? Task.CompletedTask);
        }
    }

    private void ToggleEditProfile()
    {
        _isEditingProfile = !_isEditingProfile;
        if (_isEditingProfile) {
            _originalUserName = _userName;
            _tempProfileImagePath = ""; 
            _tempBase64 = "";
        }
    }
    
    private void CancelEdit()
    {
        _userName = _originalUserName;
        _tempProfileImagePath = "";
        _tempBase64 = "";
        _isEditingProfile = false;
    }
    
    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            // Limit size to 5MB
            long maxFileSize = 5 * 1024 * 1024;
            
            // Generate unique path
            var newFile = Path.Combine(FileSystem.AppDataDirectory, $"profile_{Guid.NewGuid()}.jpg");

            // Open stream from browser file
            // We must copy it to a local file stream
            using var stream = file.OpenReadStream(maxFileSize);
            using var fileStream = File.Create(newFile);
            await stream.CopyToAsync(fileStream);

            // Create Base64 for Preview
            // We need to read the file we just saved (or read from stream again if we memory streamed it, but file is safer for memory)
            fileStream.Close(); // Ensure flush
            
            var bytes = await File.ReadAllBytesAsync(newFile);
            var base64 = Convert.ToBase64String(bytes);
            
            // Determine mime type roughly
            var mimeType = "image/jpeg";
            if (file.Name.EndsWith("png", StringComparison.OrdinalIgnoreCase)) mimeType = "image/png";

            _tempProfileImagePath = newFile;
            _tempBase64 = $"data:{mimeType};base64,{base64}";
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await ShowAlert("Error", "Could not upload image: " + ex.Message);
        }
    }

    /// <summary>
    /// Saves the updated user profile information (Name and Image).
    /// Persists data to Preferences and Toast notification.
    /// </summary>
    private void SaveProfile()
    {
        if (string.IsNullOrWhiteSpace(_userName))
        {
            _userName = "Journal User";
        }
        Preferences.Set("UserName", _userName);
        
        if (!string.IsNullOrEmpty(_tempProfileImagePath))
        {
            _profileImagePath = _tempProfileImagePath;
            Preferences.Set("UserProfileImage", _profileImagePath);
            
            // Update persistent base64 for immediate view update
            if (!string.IsNullOrEmpty(_tempBase64)) 
            {
                _profileImageBase64 = _tempBase64;
            }
        }
        
        _isEditingProfile = false;
        ToastService.ShowSuccess("Profile updated successfully! ");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
             _isDarkMode = await JSRuntime.InvokeAsync<bool>("isDarkTheme");
             StateHasChanged();
        }
    }





    private async Task SetLightMode()
    {
        if (_isDarkMode)
        {
            _isDarkMode = false;
            await JSRuntime.InvokeVoidAsync("toggleTheme");
        }
    }

    private async Task SetDarkMode()
    {
        if (!_isDarkMode)
        {
            _isDarkMode = true;
            await JSRuntime.InvokeVoidAsync("toggleTheme");
        }
    }
}
