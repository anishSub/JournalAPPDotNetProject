</aside>

@code {
    private bool _isDarkMode = false;
    private int _streak = 0;

    /// <summary>
    /// Initializes the component by fetching the current user streak.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        _streak = await JournalService.GetCurrentStreakAsync();
    }

    /// <summary>
    /// Lifecycle hook for JS interop after rendering (Theme Sync).
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Sync initial state from JS
            _isDarkMode = await JSRuntime.InvokeAsync<bool>("isDarkTheme");
            StateHasChanged();
        }
    }
    
    // ... toggle theme ...
    private async Task ToggleTheme()
    {
        // Call the global JS function we defined in index.html
        _isDarkMode = await JSRuntime.InvokeAsync<bool>("toggleTheme");
    }

    private void NavigateToNewEntry()
    {
        Navigation.NavigateTo("journal/create");
    }

    private void HandleLogout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("login", true);
    }
}
