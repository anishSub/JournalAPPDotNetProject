@using JournalApp.Services
@inject ToastService ToastService
@implements IDisposable

<div class="toast-container">
    @foreach (var toast in _toasts)
    {
        <div class="toast toast-@toast.Type.ToString().ToLower() @(toast.IsVisible ? "show" : "")">
            <div class="toast-icon">
                @switch (toast.Type)
                {
                    case ToastType.Success:
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        break;
                    case ToastType.Info:
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        break;
                    case ToastType.Warning:
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        break;
                    case ToastType.Error:
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="15" y1="9" x2="9" y2="15"></line>
                            <line x1="9" y1="9" x2="15" y2="15"></line>
                        </svg>
                        break;
                }
            </div>
            <div class="toast-content">
                <p>@toast.Message</p>
            </div>
            <button class="toast-close" @onclick="() => RemoveToast(toast)">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    }
</div>

@code {
    private List<ToastModel> _toasts = new();

    protected override void OnInitialized()
    {
        ToastService.OnShow += ShowToast;
    }

    private async void ShowToast(string message, ToastType type)
    {
        var toast = new ToastModel
        {
            Id = Guid.NewGuid(),
            Message = message,
            Type = type,
            IsVisible = false
        };

        _toasts.Add(toast);
        await InvokeAsync(StateHasChanged);

        // Trigger animation after a brief delay
        await Task.Delay(100);
        toast.IsVisible = true;
        await InvokeAsync(StateHasChanged);

        // Auto-remove after 4 seconds
        _ = Task.Run(async () =>
        {
            await Task.Delay(4000);
            await InvokeAsync(() => RemoveToast(toast));
        });
    }

    private async void RemoveToast(ToastModel toast)
    {
        if (!_toasts.Contains(toast)) return;
        
        toast.IsVisible = false;
        await InvokeAsync(StateHasChanged);

        // Wait for fade-out animation
        await Task.Delay(300);
        _toasts.Remove(toast);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ToastService.OnShow -= ShowToast;
    }

    private class ToastModel
    {
        public Guid Id { get; set; }
        public string Message { get; set; } = string.Empty;
        public ToastType Type { get; set; }
        public bool IsVisible { get; set; }
    }
}
